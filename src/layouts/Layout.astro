---
import { ViewTransitions } from 'astro:transitions';
import SpeedInsights from "@vercel/speed-insights/astro"
export interface Props {
  title: string;
  description?: string;
  keywords?: string;
}

const { title, description = 'Big Invisible - Strategic branding and design agency', keywords = 'biginvisible, branding, design, strategy' } = Astro.props;

// Generate canonical URL safely
let canonicalURL = 'https://biginvisible.com';
try {
  // Use the pathname from Astro.url if available
  const pathname = Astro.url?.pathname || '/';
  // Ensure we use the non-www version and remove any trailing slashes except for root
  canonicalURL = `https://biginvisible.com${pathname === '/' ? '' : pathname.replace(/\/$/, '')}`;
} catch (e) {
  // Fallback to base URL if there's any error
  canonicalURL = 'https://biginvisible.com';
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    
    <!-- View Transitions for smooth navigation -->
    <ViewTransitions />
    
    <!-- Prefetch links on hover for instant navigation -->
    <script>
      // Add prefetch on hover and instant touch navigation for all internal links
      document.addEventListener('astro:page-load', () => {
        const links = document.querySelectorAll('a[href^="/"]');
        let touchStartY = 0;
        let touchStartTime = 0;
        let navigationTriggered = false;
        
        links.forEach(link => {
          // Prefetch on hover for desktop
          link.addEventListener('mouseenter', () => {
            const href = link.getAttribute('href');
            if (href && !document.querySelector(`link[rel="prefetch"][href="${href}"]`)) {
              const prefetchLink = document.createElement('link');
              prefetchLink.rel = 'prefetch';
              prefetchLink.href = href;
              document.head.appendChild(prefetchLink);
            }
          });
          
          // Instant navigation on touchstart for mobile
          link.addEventListener('touchstart', ((e: any) => {
            const touchEvent = e as TouchEvent;
            touchStartY = touchEvent.touches[0].clientY;
            touchStartTime = Date.now();
            navigationTriggered = false;
            
            // Prefetch immediately on touch
            const href = link.getAttribute('href');
            if (href && !document.querySelector(`link[rel="prefetch"][href="${href}"]`)) {
              const prefetchLink = document.createElement('link');
              prefetchLink.rel = 'prefetch';
              prefetchLink.href = href;
              document.head.appendChild(prefetchLink);
            }
            
            // Set a small delay to differentiate between tap and scroll
            setTimeout(() => {
              if (!navigationTriggered && Date.now() - touchStartTime < 200) {
                // Check if it's not a scroll gesture
                const touchEndY = touchEvent.touches[0]?.clientY || touchStartY;
                if (Math.abs(touchEndY - touchStartY) < 10) {
                  navigationTriggered = true;
                  // Trigger navigation immediately
                  touchEvent.preventDefault();
                  const clickEvent = new MouseEvent('click', {
                    view: window,
                    bubbles: true,
                    cancelable: true
                  });
                  link.dispatchEvent(clickEvent);
                }
              }
            }, 50);
          }) as any, { passive: false });
          
          // Prevent default click if navigation was already triggered
          link.addEventListener('click', (e) => {
            if (navigationTriggered) {
              e.preventDefault();
              navigationTriggered = false;
            }
          });
          
          // Reset flag on touchend
          link.addEventListener('touchend', () => {
            setTimeout(() => {
              navigationTriggered = false;
            }, 100);
          });
          
          // Cancel navigation on touchmove (scrolling)
          link.addEventListener('touchmove', () => {
            navigationTriggered = true; // Prevent navigation during scroll
          });
        });
      });
    </script>
  </head>
  <body>
    <slot />
    <SpeedInsights />
  </body>
</html>
