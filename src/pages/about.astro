---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../PageWrapper';
import AboutPage from '../pages-content/About';

const currentPath = Astro.url.pathname;
---

<Layout title="About - Big Invisible" description="What makes us tick? Learn more about our mission and values." keywords="kitsap, poulsbo, seattle, washington, biginvisible, about, mission, values">
	<PageWrapper client:load currentPath={currentPath}>
		<AboutPage client:visible />
	</PageWrapper>
</Layout>
