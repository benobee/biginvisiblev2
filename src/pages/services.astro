---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../PageWrapper';
import ServicesPage from '../pages-content/Services';

const currentPath = Astro.url.pathname;
---

<Layout title="Services - Big Invisible" description="Comprehensive branding and design services to elevate your business." keywords="kitsap, poulsbo, seattle, washington, biginvisible, services, branding, design, strategy">
	<PageWrapper client:load currentPath={currentPath}>
		<ServicesPage client:visible />
	</PageWrapper>
</Layout>
