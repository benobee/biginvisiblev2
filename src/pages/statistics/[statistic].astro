---
import App from "../../App";
import { brandingStatistics } from '../../data/brandingStatistics';

export async function getStaticPaths() {
  return brandingStatistics.map((statistic) => ({
    params: { statistic: statistic.id },
    props: {
      title: `${statistic.percentage}% ${statistic.statement} - Big Invisible`,
      description: `Understand what this branding statistic means for your business: ${statistic.statement}`,
      keywords: `branding statistics, ${statistic.categories.join(', ')}, brand insights, marketing data`
    }
  }));
}

const { title, description, keywords } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<title>{title}</title>
	</head>
	<body>
		<App client:only="react" />
	</body>
</html>