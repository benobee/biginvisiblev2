---
// This page handles legacy URLs with query parameters and redirects to the new path-based URLs
const statisticId = Astro.url.searchParams.get('id');

if (statisticId) {
  // Redirect to the new URL structure
  return Astro.redirect(`/stat-detail/${statisticId}`, 301);
}

// If no ID is provided, redirect to the statistics page
return Astro.redirect('/statistics', 301);
---
