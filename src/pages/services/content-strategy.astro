---
import Layout from '../../layouts/Layout.astro';
import PageWrapper from '../../PageWrapper';
import ContentStrategyPage from '../../pages-content/services/ContentStrategy';

const currentPath = Astro.url.pathname;
---

<Layout title="Content Strategy - Big Invisible" description="Strategic content planning and development." keywords="kitsap, poulsbo, seattle, washington, content strategy, content planning, content development">
	<PageWrapper client:load currentPath={currentPath}>
		<ContentStrategyPage client:visible currentPath={currentPath} />
	</PageWrapper>
</Layout>