---
import Layout from '../../layouts/Layout.astro';
import PageWrapper from '../../PageWrapper';
import DigitalExperiencePage from '../../pages-content/services/DigitalExperience';

const currentPath = Astro.url.pathname;
---

<Layout title="Digital Experience - Big Invisible" description="User-centered digital experiences and web design." keywords="digital experience, web design, UX design">
	<PageWrapper client:load currentPath={currentPath}>
		<DigitalExperiencePage client:visible currentPath={currentPath} />
	</PageWrapper>
</Layout>