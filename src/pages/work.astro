---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../PageWrapper';
import WorkPage from '../pages-content/Work';

const currentPath = Astro.url.pathname;
---

<Layout title="Work - Big Invisible" description="Explore our portfolio of successful branding and design projects." keywords="biginvisible, work, portfolio, case studies, projects">
	<PageWrapper client:load currentPath={currentPath}>
		<WorkPage />
	</PageWrapper>
</Layout>