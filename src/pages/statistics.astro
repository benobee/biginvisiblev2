---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../PageWrapper';
import Statistics from '../pages-content/Statistics';

const currentPath = Astro.url.pathname;
---

<Layout title="Statistics - Big Invisible" description="Explore comprehensive branding statistics organized by category. Discover insights on brand strategy, visual identity, digital experience, and more." keywords="branding statistics, brand insights, marketing data, brand strategy, visual identity, digital experience, content strategy, community building, brand architecture">
	<PageWrapper client:load currentPath={currentPath}>
		<Statistics currentPath={currentPath} />
	</PageWrapper>
</Layout>