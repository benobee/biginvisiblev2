{
  "manifest_version": 3,
  "name": "MockMonkey DevTools",
  "version": "2.0.0",
  "description": "HTTP Request Logger & Response Mocker for Chrome DevTools",
  
  "permissions": [
    "activeTab",
    "debugger", 
    "storage",
    "tabs",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "webRequest"
  ],
  
  "host_permissions": [
    "https://*.console.aws-dev.amazon.com/*",
    "https://*.console.aws.amazon.com/*",
    "https://*.amazonaws.com/*",
    "http://localhost:*/*",
    "https://localhost:*/*"
  ],

  "background": {
    "service_worker": "background/background.js"
  },

  "devtools_page": "devtools/devtools.html",

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/network-interceptor.js", "content/stealth-interceptor.js"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MockMonkey DevTools"
  },

  "web_accessible_resources": [
    {
      "resources": ["shared/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
